{
	"comments": {
		"blockComment": ["/*", "*/"]
	},
	"brackets": [
		["{", "}"],
		["<", ">"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "<", "close": ">" },
		{ "open": "/*", "close": " */", "notIn": ["string"] }
	],
	"surroundingPairs": [
		["{", "}"],
		["<", ">"]
	],
	"folding": {
		"markers": {
			"start": "^\\s*<[A-Z_]+>\\s*$",
			"end": "^\\s*</[A-Z_]+>\\s*$"
		}
	}
}
