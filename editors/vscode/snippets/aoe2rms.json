	"Section header": {
		"prefix": "section",
		"body": [
			"<${1|PLAYER_SETUP,LAND_GENERATION,ELEVATION_GENERATION,CLIFF_GENERATION,TERRAIN_GENERATION,CONNECTION_GENERATION,OBJECTS_GENERATION|}>$0"
		],
		"description": "RMS section header"
	},
	"create_player_lands": {
		"prefix": "player_lands",
		"body": [
			"create_player_lands {",
			"\tterrain_type ${1:GRASS}",
			"\tland_percent ${2:60}",
			"\tbase_size ${3:5}",
			"}$0"
		],
		"description": "Player lands block"
	},
	"create_land": {
		"prefix": "land",
		"body": [
			"create_land {",
			"\tterrain_type ${1:GRASS}",
			"\tland_percent ${2:10}",
			"\tleft_border ${3:10}",
			"\tright_border ${4:10}",
			"\ttop_border ${5:10}",
			"\tbottom_border ${6:10}",
			"\tborder_fuzziness ${7:10}",
			"\tclumping_factor ${8:70}",
			"}$0"
		],
		"description": "Neutral land block"
	},
	"create_terrain": {
		"prefix": "terrain",
		"body": [
			"create_terrain ${1:FOREST}",
			"{",
			"\tland_percent ${2:12}",
			"\tnumber_of_clumps ${3:18}",
			"\tset_scale_by_size",
			"\tspacing_to_other_terrain_types ${4:2}",
			"}$0"
		],
		"description": "Terrain patch block"
	},
	"create_object": {
		"prefix": "object",
		"body": [
			"create_object ${1:GOLD}",
			"{",
			"\tnumber_of_objects ${2:7}",
			"\tnumber_of_groups ${3:1}",
			"\tgroup_placement_radius 2",
			"\tset_tight_grouping",
			"\tset_place_for_every_player",
			"\tmin_distance_to_players ${4:10}",
			"}$0"
		],
		"description": "Object placement block"
	},
	"create_elevation": {
		"prefix": "elevation",
		"body": [
			"create_elevation ${1:7}",
			"{",
			"\tbase_terrain ${2:GRASS}",
			"\tnumber_of_clumps ${3:14}",
			"\tnumber_of_tiles ${4:2500}",
			"\tset_scale_by_size",
			"}$0"
		],
		"description": "Elevation block"
	},
	"Land connection": {
		"prefix": "connection",
		"body": [
			"create_connect_all_players_land",
			"{",
			"\treplace_terrain ${1:WATER} ${2:SHALLOW}",
			"\tterrain_cost ${3:WATER} ${4:1}",
			"\tterrain_size ${5:WATER} ${6:2} ${7:1}",
			"}$0"
		],
		"description": "Connect players' lands over terrain"
	},
	"start_random block": {
		"prefix": "start_random",
		"body": [
			"start_random",
			"\tpercent_chance ${1:50}",
			"\t\t${2:create_object SHEEP}",
			"\tpercent_chance ${3:50}",
			"\t\t${4:create_object DEER}",
			"end_random$0"
		],
		"description": "Random choice between branches (percentages sum to 100)"
	},
	"base_terrain": {
		"prefix": "base_terrain",
		"body": [
			"base_terrain ${1:GRASS}$0"
		],
		"description": "Map base terrain"
	},
	"#const": {
		"prefix": "const",
		"body": [
			"#const ${1:ROCKS} ${2:40}$0"
		],
		"description": "Named constant in the header (keep all #const together)"
	}
