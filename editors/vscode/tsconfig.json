{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2022"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node"],
		// The tests run on Node's type stripping and import ./x.ts with the
		// explicit extension; noEmit makes the flag legal for tsc too.
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
