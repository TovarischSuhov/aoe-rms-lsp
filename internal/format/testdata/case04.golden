<terrain_generation>
    if TINY_MAP
        create_terrain GRASS {
            number_of_real_tiles 100
        }
    elseif MEDIUM_MAP
        create_terrain DIRT {
            number_of_real_tiles 200
        }
    else
        create_terrain PAVEMENT {
            number_of_real_tiles 300
        }
    endif
</terrain_generation>
